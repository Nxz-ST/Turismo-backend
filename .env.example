APP_ENV=development
MAX_REQUEST_BYTES=2000000
APP_NAME=RutaAmiga API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080"]

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Acepta la nueva sb_secret_... o la legacy service_role.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY

# Cloudflare R2 (API compatible con S3)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=turismo-evidencias
R2_PRESIGNED_URL_TTL_SECONDS=900

# Motor existente. No requiere modificaciones en /predict.
AI_SERVICE_BASE_URL=https://YOUR_RUNPOD_HOST
AI_SERVICE_TIMEOUT_SECONDS=300

# Clave de servidor: Places API (New) + Routes API. No reutilizar la de iOS/Android.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_SERVER_API_KEY

# MVP: ejecuta el trabajo con BackgroundTasks. En produccion se reemplaza por worker.
PROCESS_JOBS_INLINE=true

# El catalogo STAC funciona sin credenciales. Para calcular NDVI/NDWI/NDSI/BSI,
# crea un OAuth Client en Copernicus Data Space y completa las dos variables.
SENTINEL_ENABLED=true
SENTINEL_CLIENT_ID=YOUR_COPERNICUS_OAUTH_CLIENT_ID
SENTINEL_CLIENT_SECRET=YOUR_COPERNICUS_OAUTH_CLIENT_SECRET
SENTINEL_LOOKBACK_DAYS=180
SENTINEL_BUFFER_M=120
PERUSAT_ENABLED=false

# Parametros heurísticos iniciales. Deben calibrarse experimentalmente.
DECISION_RULE_VERSION=multimodal-v1
CANDIDATE_SCORE_THRESHOLD=0.75
MINIMUM_EVIDENCE_COVERAGE=0.70

